# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Random 32-byte hex string. Its SHA-256 hash must be stored in
# private.config under the key 'server_secret_sha256' (see README).
EXAM_SERVER_SECRET=

# Random string used to hash guest IP addresses.
IP_HASH_SALT=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase Storage folder that serves question images (optional)
NEXT_PUBLIC_ASSET_BASE=
